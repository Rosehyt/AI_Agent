# Neo4j Connection (Local Default)
# If the TA uses Docker, these are the standard default settings.

# Docker 
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Note: This system uses a local LLM (Qwen2.5-3B-Instruct). 
# No API keys are required.
# Before running the test, please ensure Neo4j is running and execute:
# python build_kg.py
